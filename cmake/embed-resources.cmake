# Run with `cmake -DRESOURCES_DIR=... -DPREFIX=/ui/ -DOUTPUT=... -P embed-resources.cmake`
# Generates a .cpp file defining `webclap::embeddedResources` (see shared/webclap/resources.h)

set(entries "")
set(arrays "")
set(index 0)

if (RESOURCES_DIR)
	file(GLOB_RECURSE files RELATIVE ${RESOURCES_DIR} ${RESOURCES_DIR}/*)
	list(SORT files)
endif()

foreach(relPath ${files})
	get_filename_component(ext ${relPath} LAST_EXT)
	string(TOLOWER "${ext}" ext)
	set(mime "application/octet-stream")
	if (ext STREQUAL ".html")
		set(mime "text/html")
	elseif (ext STREQUAL ".js" OR ext STREQUAL ".mjs")
		set(mime "text/javascript")
	elseif (ext STREQUAL ".css")
		set(mime "text/css")
	elseif (ext STREQUAL ".svg")
		set(mime "image/svg+xml")
	elseif (ext STREQUAL ".png")
		set(mime "image/png")
	elseif (ext STREQUAL ".json")
		set(mime "application/json")
	elseif (ext STREQUAL ".woff2")
		set(mime "font/woff2")
	endif()

	file(READ ${RESOURCES_DIR}/${relPath} hex HEX)
	string(LENGTH "${hex}" hexLength)
	math(EXPR size "${hexLength} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
	string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")

	string(APPEND arrays "static const unsigned char resource${index}[] = {\n${hex}0};\n")
	string(APPEND entries "\t{\"${PREFIX}${relPath}\", \"${mime}\", resource${index}, ${size}},\n")
	math(EXPR index "${index} + 1")
endforeach()

file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed-resources.cmake - do not edit\n#include \"webclap/resources.h\"\n\nnamespace webclap {\n\n${arrays}\nconst EmbeddedResource embeddedResources[] = {\n${entries}\t{nullptr, nullptr, nullptr, 0}\n};\n\n} // namespace\n")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
